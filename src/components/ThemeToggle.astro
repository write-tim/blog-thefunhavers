---
import Icon from './Icon.astro';
---

<button class="theme-toggle" type="button" aria-label="Toggle theme">
  <span class="icon-sun"><Icon name="sun" size={18} /></span>
  <span class="icon-moon"><Icon name="moon" size={18} /></span>
</button>

<style>
  .icon-sun, .icon-moon {
    display: inline-flex;
    align-items: center;
  }
  html[data-theme='dark'] .icon-sun { display: none; }
  html[data-theme='light'] .icon-moon { display: none; }
</style>

<script>
  function setupThemeToggles() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

    buttons.forEach((btn) => {
      // Remove any existing listener by replacing or checking flag
      if (btn.dataset.themeBound) return;
      btn.dataset.themeBound = 'true';

      btn.addEventListener('click', () => {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const nextTheme = isDark ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
      });
    });
  }

  setupThemeToggles();
  document.addEventListener('astro:page-load', setupThemeToggles);
</script>
