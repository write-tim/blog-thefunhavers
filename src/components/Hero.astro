---
import { typingRoles as defaultTypingRoles } from '../data/resume';
import { site, withBase } from '../data/site';
import Icon from './Icon.astro';
import { getEntry } from 'astro:content';

const homeEntry = await getEntry('site', 'home');
const homeData = homeEntry?.data;

const greeting = homeData?.greeting ?? "Hello, we're";
const firstName = homeData?.firstName ?? site.author.name.split(' ')[0] ?? '';
const lastName = homeData?.lastName ?? site.author.name.split(' ').slice(1).join(' ') ?? '';

const roles = (homeData?.typingRoles && homeData.typingRoles.length > 0)
  ? homeData.typingRoles
  : defaultTypingRoles;
const rolesJson = JSON.stringify(roles);

const bio = homeData?.bio ?? homeData?.description ?? site.description;
const avatar = homeData?.avatar || '/img/avatar.svg';

export interface HeroButton {
  label: string;
  url: string;
  icon?: string;
  show?: boolean;
}

const defaultButtons: HeroButton[] = Object.values(site.socials).map((s) => ({
  label: s.label,
  url: s.url,
  icon: s.icon,
  show: true,
}));

const buttons: HeroButton[] =
  homeData?.buttons && Array.isArray(homeData.buttons) && homeData.buttons.length > 0
    ? homeData.buttons
    : defaultButtons;

// Helper to determine the icon name
const resolveIcon = (icon?: string, label = '', url = '') => {
  if (icon === 'none') return null;
  if (icon && icon !== 'auto') return icon;

  const text = `${label} ${url}`.toLowerCase();
  if (text.includes('github')) return 'github';
  if (text.includes('linkedin')) return 'linkedin';
  if (text.includes('instagram')) return 'instagram';
  if (text.includes('youtube') || text.includes('youtu.be')) return 'youtube';
  if (text.includes('twitter') || text.includes('x.com')) return 'x';
  if (text.includes('mail') || text.includes('@')) return 'email';
  if (text.includes('rss') || text.includes('feed')) return 'rss';
  if (text.includes('phone') || text.includes('tel:')) return 'phone';
  if (url.endsWith('.pdf') || text.includes('download')) return 'download';
  if (text.includes('resume') || text.includes('cv')) return 'file-text';
  if (
    text.includes('portfolio') ||
    text.includes('blog') ||
    text.includes('site') ||
    text.includes('web')
  ) {
    return 'globe';
  }
  if (url.startsWith('http') || url.startsWith('/')) return 'arrow-right';
  return null;
};
---

<section class="hero">
  <div class="stars" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div>
      <p class="hero-greeting">{greeting}</p>
      <h1>{firstName} {lastName && <span class="accent">{lastName}</span>}</h1>
      <p class="hero-typed">
        <span class="typed" id="typed-roles" data-roles={rolesJson}></span><span class="typed-cursor" aria-hidden="true">▍</span>
      </p>

      <p class="hero-bio">
        {bio}
      </p>

      <div class="social-row">
        {buttons
          .filter((b) => b.show !== false && b.label && b.label.trim().length > 0)
          .map((b) => {
            const iconName = resolveIcon(b.icon, b.label, b.url);
            const isExternal = b.url.startsWith('http');
            return (
              <a
                class="social-link"
                href={withBase(b.url)}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener' : undefined}
              >
                {iconName && <Icon name={iconName as any} />}
                {b.label}
              </a>
            );
          })}
      </div>
    </div>

    <img class="hero-avatar" src={withBase(avatar)} alt={`Portrait of ${firstName} ${lastName}`} width="220" height="220" />
  </div>
</section>

<script>
  const el = document.getElementById('typed-roles');
  if (el) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    let roleIndex = 0;
    let charIndex = 0;
    let deleting = false;

    const tick = () => {
      const word = roles[roleIndex];
      if (!deleting) {
        charIndex++;
        el.textContent = word.slice(0, charIndex);
        if (charIndex === word.length) {
          deleting = true;
          setTimeout(tick, 1800);
          return;
        }
        setTimeout(tick, 70);
      } else {
        charIndex--;
        el.textContent = word.slice(0, charIndex);
        if (charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          setTimeout(tick, 350);
          return;
        }
        setTimeout(tick, 35);
      }
    };

    tick();
  }
</script>
