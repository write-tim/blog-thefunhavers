---
import { site, withBase } from '../data/site';
import { getEntry, getCollection } from 'astro:content';

const headerFooterEntry = await getEntry('pages', 'header-footer');
const hfData = headerFooterEntry?.data;

let customPages: any[] = [];
try {
  const allPages = await getCollection('pages');
  const reservedPageIds = new Set(['home', 'header-footer', 'work', 'projects']);
  customPages = allPages.filter(
    (p) => !reservedPageIds.has(p.id.replace(/\.(md|mdx)$/, ''))
  );
} catch (e) {}

const showFooterNav = hfData?.showFooterNav ?? true;
const showFooterSocials = hfData?.showFooterSocials ?? true;

const defaultNavLinks = [
  { href: '/', label: 'Home', show: true },
  { href: '/work', label: 'Work', show: true },
  { href: '/blog', label: 'Blog', show: true },
  { href: '/travel', label: 'Travel', show: true },
];

const flattenNav = (items: any[]) => {
  const result: { href: string; label: string; show: boolean }[] = [];
  for (const item of items) {
    if (item.show === false) continue;
    if (item.children && Array.isArray(item.children) && item.children.length > 0) {
      for (const child of item.children) {
        if (child.show !== false && child.url) {
          result.push({ href: child.url, label: child.label, show: true });
        }
      }
    } else if (item.url) {
      result.push({ href: item.url, label: item.label, show: true });
    }
  }
  return result;
};

const rawFooterNav =
  hfData?.footerNavLinks && Array.isArray(hfData.footerNavLinks) && hfData.footerNavLinks.length > 0
    ? flattenNav(hfData.footerNavLinks)
    : hfData?.navLinks && Array.isArray(hfData.navLinks) && hfData.navLinks.length > 0
      ? flattenNav(hfData.navLinks)
      : defaultNavLinks;

// Include custom pages that have showInFooter enabled
const footerPages = customPages.filter((p) => p.data.showInFooter);
for (const page of footerPages) {
  const slug = (page.data.slug || page.id).replace(/\.(md|mdx)$/, '').replace(/^\/+|\/+$/g, '');
  const pageUrl = `/${slug}`;
  const label = page.data.navLabel || page.data.title;
  const alreadyExists = rawFooterNav.some(
    (l) => l.href.replace(/\/+$/, '') === pageUrl.replace(/\/+$/, '')
  );
  if (!alreadyExists) {
    rawFooterNav.push({ href: pageUrl, label, show: true });
  }
}

const footerNav = rawFooterNav
  .filter((l) => l.show !== false && l.label && l.label.trim().length > 0)
  .map((l) => ({
    ...l,
    href:
      l.href.startsWith('http') || l.href.startsWith('mailto:') || l.href.startsWith('tel:')
        ? l.href
        : withBase(l.href),
    isExternal: l.href.startsWith('http'),
  }));

const defaultSocialLinks = Object.values(site.socials).map((s) => ({
  href: s.url,
  label: s.label,
  show: true,
}));

const rawFooterSocials =
  hfData?.footerSocialLinks &&
  Array.isArray(hfData.footerSocialLinks) &&
  hfData.footerSocialLinks.length > 0
    ? hfData.footerSocialLinks.map((l) => ({ href: l.url, label: l.label, show: l.show !== false }))
    : defaultSocialLinks;

const footerSocials = rawFooterSocials
  .filter((s) => s.show !== false && s.label && s.label.trim().length > 0)
  .map((s) => ({
    ...s,
    href:
      s.href.startsWith('http') || s.href.startsWith('mailto:') || s.href.startsWith('tel:')
        ? s.href
        : withBase(s.href),
    isExternal: s.href.startsWith('http'),
  }));

const currentYear = new Date().getFullYear().toString();
const defaultCopyright = `© {year} ${site.author.name} · ${site.author.location}`;
const rawCopyright = hfData?.copyrightText || defaultCopyright;
const copyright = rawCopyright.replace(/\{year\}/g, currentYear);
---

<footer class="site-footer">
  <div class="container footer-inner">
    {showFooterNav && footerNav.length > 0 && (
      <ul class="footer-links">
        {footerNav.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.isExternal ? '_blank' : undefined}
              rel={l.isExternal ? 'noopener' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )}
    {showFooterSocials && footerSocials.length > 0 && (
      <ul class="footer-links">
        {footerSocials.map((s) => (
          <li>
            <a
              href={s.href}
              target={s.isExternal ? '_blank' : undefined}
              rel={s.isExternal ? 'noopener' : undefined}
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    )}
    {copyright && copyright.trim().length > 0 && <p>{copyright}</p>}
  </div>
</footer>
