---
import { skillGroups as defaultSkills } from '../data/resume';
import type { SkillGroup as SkillGroupType } from '../data/resume';

interface Props {
  skillGroups?: SkillGroupType[];
}

const skillGroups = Astro.props.skillGroups ?? defaultSkills;
---

<section class="section section-alt" id="skills">
  <div class="container">
    <p class="eyebrow">Skills</p>
    <h2 class="section-heading">What I work with</h2>
    {
      skillGroups.map((group) => (
        <div class="skill-group">
          <h3>{group.title}</h3>
          <div class="chip-row">
            {group.skills.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</section>
