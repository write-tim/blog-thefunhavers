---
import ThemeToggle from './ThemeToggle.astro';
import { site, withBase } from '../data/site';
import { getEntry, getCollection } from 'astro:content';

const headerFooterEntry = await getEntry('pages', 'header-footer');
const hfData = headerFooterEntry?.data;

let customPages: any[] = [];
try {
  const allPages = await getCollection('pages');
  const reservedPageIds = new Set(['home', 'header-footer', 'work', 'projects']);
  customPages = allPages.filter(
    (p) => !reservedPageIds.has(p.id.replace(/\.(md|mdx)$/, ''))
  );
} catch (e) {
  // Collection might be empty
}

const brandName = hfData?.brandName ?? site.shortTitle;
const brandPrefix = hfData?.brandPrefix ?? '>';
const brandSuffix = hfData?.brandSuffix ?? '_';
const showThemeToggle = hfData?.showThemeToggle ?? true;

interface SubNavLink {
  label: string;
  url: string;
  show?: boolean;
}

interface NavItem {
  type?: string;
  label: string;
  url?: string;
  show?: boolean;
  children?: SubNavLink[];
}

const defaultNavItems: NavItem[] = [
  { type: 'link', label: 'Home', url: '/', show: true },
  {
    type: 'dropdown',
    label: 'Personal',
    show: true,
    children: [
      { label: 'Blog', url: '/blog', show: true },
      { label: 'Travel', url: '/travel', show: true },
    ],
  },
  {
    type: 'dropdown',
    label: 'Professional',
    show: true,
    children: [
      { label: 'Work', url: '/work', show: true },
      { label: 'Projects', url: '/projects', show: true },
    ],
  },
];

const rawNavItems: NavItem[] =
  hfData?.navLinks && Array.isArray(hfData.navLinks) && hfData.navLinks.length > 0
    ? (structuredClone(hfData.navLinks) as NavItem[])
    : structuredClone(defaultNavItems);

// Automatically integrate custom pages based on navPlacement
const placedPages = customPages
  .filter((p) => p.data.navPlacement && p.data.navPlacement !== 'none')
  .sort((a, b) => (a.data.navOrder ?? 100) - (b.data.navOrder ?? 100));

for (const page of placedPages) {
  const slug = (page.data.slug || page.id).replace(/\.(md|mdx)$/, '').replace(/^\/+|\/+$/g, '');
  const pageUrl = `/${slug}`;
  const label = page.data.navLabel || page.data.title;
  const placement = page.data.navPlacement;

  if (placement === 'personal' || placement === 'professional') {
    let targetGroup = rawNavItems.find(
      (item) => item.label.toLowerCase() === placement.toLowerCase()
    );
    if (!targetGroup) {
      targetGroup = {
        type: 'dropdown',
        label: placement.charAt(0).toUpperCase() + placement.slice(1),
        show: true,
        children: [],
      };
      rawNavItems.push(targetGroup);
    }
    targetGroup.children = targetGroup.children || [];
    const alreadyExists = targetGroup.children.some(
      (child) => child.url.replace(/\/+$/, '') === pageUrl.replace(/\/+$/, '')
    );
    if (!alreadyExists) {
      targetGroup.children.push({ label, url: pageUrl, show: true });
    }
  } else if (placement === 'top') {
    const alreadyExists = rawNavItems.some(
      (item) => item.url && item.url.replace(/\/+$/, '') === pageUrl.replace(/\/+$/, '')
    );
    if (!alreadyExists) {
      rawNavItems.push({ type: 'link', label, url: pageUrl, show: true });
    }
  }
}

const formatHref = (url?: string) => {
  if (!url) return '';
  if (
    url.startsWith('http://') ||
    url.startsWith('https://') ||
    url.startsWith('mailto:') ||
    url.startsWith('tel:')
  ) {
    return url;
  }
  return withBase(url);
};

const currentPath = Astro.url.pathname;
const isCurrent = (href?: string) => {
  if (!href) return false;
  const normalizedCurrent = currentPath.replace(/\/+$/, '') || '/';
  const normalizedHref = href.replace(/\/+$/, '') || '/';
  return normalizedCurrent === normalizedHref;
};

const hasActiveChild = (children?: SubNavLink[]) => {
  if (!children) return false;
  return children.some((c) => c.show !== false && isCurrent(formatHref(c.url)));
};

const navItems = rawNavItems.filter(
  (item) => item.show !== false && item.label && item.label.trim().length > 0
);
---

<header class="site-header" id="site-header">
  <div class="container nav">
    <a class="brand" href={withBase('/')}>
      {brandPrefix && <span class="brand-prefix" aria-hidden="true">{brandPrefix}</span>}{' '}
      <span class="brand-name">{brandName}</span>
      {brandSuffix && <span class="brand-suffix">{brandSuffix}</span>}
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        {
          navItems.map((item) => {
            const hasChildren = item.children && item.children.length > 0;
            if (!hasChildren) {
              const href = formatHref(item.url);
              const active = isCurrent(href);
              const isExternal = href.startsWith('http');
              return (
                <li class="nav-item">
                  <a
                    href={href}
                    aria-current={active ? 'page' : undefined}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener' : undefined}
                    class:list={['nav-link', { active }]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            }

            const active = hasActiveChild(item.children);
            const visibleChildren = item.children!.filter((c) => c.show !== false);

            return (
              <li class="nav-item nav-dropdown" data-dropdown>
                <button
                  type="button"
                  class:list={['nav-link', 'dropdown-trigger', { active }]}
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  <span>{item.label}</span>
                  <span class="dropdown-chevron" aria-hidden="true">▾</span>
                </button>
                <ul class="dropdown-menu" role="menu">
                  {visibleChildren.map((sub) => {
                    const subHref = formatHref(sub.url);
                    const subActive = isCurrent(subHref);
                    const subExternal = subHref.startsWith('http');
                    return (
                      <li role="none">
                        <a
                          href={subHref}
                          role="menuitem"
                          aria-current={subActive ? 'page' : undefined}
                          target={subExternal ? '_blank' : undefined}
                          rel={subExternal ? 'noopener' : undefined}
                          class:list={['dropdown-link', { active: subActive }]}
                        >
                          {sub.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </li>
            );
          })
        }
        {showThemeToggle && (
          <li class="nav-item nav-theme-toggle">
            <ThemeToggle />
          </li>
        )}
      </ul>
    </nav>

    <!-- Mobile Action Buttons -->
    <div class="mobile-actions">
      {showThemeToggle && <ThemeToggle />}
      <button
        type="button"
        class="mobile-menu-btn"
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <span class="icon-hamburger" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </span>
        <span class="icon-close" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div class="mobile-nav-panel" id="mobile-nav-panel">
    <div class="container">
      <nav class="mobile-nav-tree" aria-label="Mobile Menu">
        <ul class="mobile-tree-list">
          {
            navItems.map((item) => {
              const hasChildren = item.children && item.children.length > 0;
              if (!hasChildren) {
                const href = formatHref(item.url);
                const active = isCurrent(href);
                return (
                  <li class="mobile-tree-item root-item">
                    <a
                      href={href}
                      aria-current={active ? 'page' : undefined}
                      class:list={['mobile-nav-link', { active }]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              }

              const groupActive = hasActiveChild(item.children);
              const visibleChildren = item.children!.filter((c) => c.show !== false);

              return (
                <li class="mobile-tree-item group-item">
                  <div class:list={['mobile-group-title', { active: groupActive }]}>
                    {item.label}
                  </div>
                  <ul class="mobile-sub-tree">
                    {visibleChildren.map((sub) => {
                      const subHref = formatHref(sub.url);
                      const active = isCurrent(subHref);
                      return (
                        <li class="mobile-sub-item">
                          <a
                            href={subHref}
                            aria-current={active ? 'page' : undefined}
                            class:list={['mobile-sub-link', { active }]}
                          >
                            <span class="tree-branch" aria-hidden="true">|- </span>
                            <span class="sub-label">{sub.label}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--nav-h);
  }

  .brand {
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-decoration: none;
    font-size: clamp(0.95rem, 3.8vw, 1.05rem);
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    flex-shrink: 0;
  }

  .brand-prefix,
  .brand-suffix {
    color: var(--accent);
  }

  /* List resets */
  .nav-links,
  .dropdown-menu,
  .mobile-tree-list,
  .mobile-sub-tree,
  .nav-item,
  .mobile-tree-item,
  .mobile-sub-item {
    list-style: none !important;
    list-style-type: none !important;
    margin: 0;
    padding: 0;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: var(--muted);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .dropdown-trigger {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    outline: none;
  }

  .nav-link:hover,
  .nav-dropdown:hover > .dropdown-trigger,
  .nav-dropdown.is-open > .dropdown-trigger {
    color: var(--text-strong);
    background: var(--surface-2);
  }

  .nav-link.active,
  .nav-link[aria-current='page'] {
    color: var(--text-strong);
    font-weight: 600;
  }

  .dropdown-chevron {
    font-size: 0.7rem;
    transition: transform 0.2s ease;
    opacity: 0.75;
  }

  .nav-dropdown:hover .dropdown-chevron,
  .nav-dropdown.is-open .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 160px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: 0.35rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
    z-index: 100;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown.is-open .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .dropdown-link:hover {
    color: var(--text-strong);
    background: var(--surface-2);
  }

  .dropdown-link.active,
  .dropdown-link[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
    background: var(--surface-2);
  }

  /* Mobile Actions */
  .mobile-actions {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-menu-btn {
    appearance: none;
    -webkit-appearance: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
  }

  .mobile-menu-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--surface-2);
  }

  .mobile-menu-btn .icon-close {
    display: none;
  }

  /* Mobile Panel */
  .mobile-nav-panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    padding: 1.25rem 0 1.75rem;
    z-index: 99;
  }

  .site-header.is-open .mobile-nav-panel {
    display: block;
  }

  .site-header.is-open .mobile-menu-btn .icon-hamburger {
    display: none;
  }

  .site-header.is-open .mobile-menu-btn .icon-close {
    display: block;
  }

  .mobile-tree-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-tree-item.root-item .mobile-nav-link {
    display: block;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease;
  }

  .mobile-tree-item.root-item .mobile-nav-link.active {
    color: var(--accent);
  }

  .mobile-group-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-strong);
    padding: 0.2rem 0.5rem;
    margin-bottom: 0.25rem;
  }

  .mobile-group-title.active {
    color: var(--accent);
  }

  .mobile-sub-tree {
    padding: 0 0 0 0.5rem !important;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-sub-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: var(--muted);
    text-decoration: none;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .tree-branch {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .mobile-sub-link:hover,
  .mobile-sub-link:focus {
    color: var(--text-strong);
    background: var(--surface-2);
  }

  .mobile-sub-link.active {
    color: var(--accent);
    font-weight: 600;
    background: var(--surface-2);
  }

  /* Responsive Breakpoints */
  @media (max-width: 767.98px) {
    .desktop-nav {
      display: none !important;
    }

    .mobile-actions {
      display: flex !important;
    }
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex !important;
    }

    .mobile-actions {
      display: none !important;
    }

    .mobile-nav-panel {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  // Mobile menu toggle
  if (toggleBtn && header) {
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = header.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      const panel = document.getElementById('mobile-nav-panel');
      if (panel) {
        panel.setAttribute('aria-hidden', String(!isOpen));
      }
    });
  }

  // Desktop dropdown buttons
  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector('.dropdown-trigger');
    if (!trigger) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdown.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));

      // Close other dropdowns
      dropdowns.forEach((other) => {
        if (other !== dropdown) {
          other.classList.remove('is-open');
          const otherTrigger = other.querySelector('.dropdown-trigger');
          if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });

  // Close menus when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    // Close mobile menu if clicked outside
    if (header && header.classList.contains('is-open') && !header.contains(target)) {
      header.classList.remove('is-open');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    }

    // Close desktop dropdowns if clicked outside
    dropdowns.forEach((dropdown) => {
      if (!dropdown.contains(target)) {
        dropdown.classList.remove('is-open');
        const trigger = dropdown.querySelector('.dropdown-trigger');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Close menus on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (header && header.classList.contains('is-open')) {
        header.classList.remove('is-open');
        if (toggleBtn) {
          toggleBtn.setAttribute('aria-expanded', 'false');
          toggleBtn.focus();
        }
      }
      dropdowns.forEach((dropdown) => {
        if (dropdown.classList.contains('is-open')) {
          dropdown.classList.remove('is-open');
          const trigger = dropdown.querySelector<HTMLElement>('.dropdown-trigger');
          if (trigger) {
            trigger.setAttribute('aria-expanded', 'false');
            trigger.focus();
          }
        }
      });
    }
  });

  // Close mobile menu when a mobile nav link is clicked
  const mobileLinks = document.querySelectorAll('.mobile-nav-panel a');
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (header && header.classList.contains('is-open')) {
        header.classList.remove('is-open');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
