---
import Layout from '../components/Layout.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import { site, withBase } from '../data/site';
import {
  experience as defaultExp,
  earlierRoles as defaultEarlier,
  education as defaultEdu,
  skillGroups as defaultSkills,
} from '../data/resume';
import { getEntry, render } from 'astro:content';

const workEntry = await getEntry('pages', 'work');
const workData = workEntry?.data;
const renderedWork = workEntry ? await render(workEntry) : null;
const WorkContent = renderedWork?.Content;

const pageTitle = workData?.title ?? 'Work';
const name = workData?.name ?? site.author.name;

const experience = (workData?.experience && workData.experience.length > 0)
  ? workData.experience
  : defaultExp;
const earlierRoles = workData?.earlierRoles ?? defaultEarlier;
const education = (workData?.education && workData.education.length > 0)
  ? workData.education
  : defaultEdu;
const skillGroups = (workData?.skillGroups && workData.skillGroups.length > 0)
  ? workData.skillGroups
  : defaultSkills;

const current = experience[0];
const currentRole = workData?.currentRole ?? current?.role;
const currentCompany = workData?.currentCompany ?? current?.company;
const showLocation = workData?.showLocation ?? true;
const location = workData?.location ?? site.author.location;

const showPhone = workData?.showPhone ?? true;
const phone = workData?.phone;

// Helper to format contact and social URLs
const formatUrl = (url: string) => {
  const trimmed = url.trim();
  if (
    trimmed.startsWith('http://') ||
    trimmed.startsWith('https://') ||
    trimmed.startsWith('mailto:') ||
    trimmed.startsWith('tel:')
  ) {
    return trimmed;
  }
  if (trimmed.includes('@') && !trimmed.includes('/')) {
    return `mailto:${trimmed}`;
  }
  if (/^[\d\s()+-]+$/.test(trimmed) && trimmed.replace(/\D/g, '').length >= 7) {
    return `tel:${trimmed.replace(/[^0-9+]/g, '')}`;
  }
  return trimmed.startsWith('/') ? withBase(trimmed) : `https://${trimmed}`;
};

interface HeaderItem {
  label: string;
  url?: string;
}

const headerItems: HeaderItem[] = [];

if (showLocation && location && location.trim().length > 0) {
  headerItems.push({ label: location.trim() });
}

// Check if contactLinks already includes a phone number entry
const hasPhoneInLinks = workData?.contactLinks?.some(
  (l) => l.url.startsWith('tel:') || (phone && l.label.includes(phone))
);

if (showPhone && phone && phone.trim().length > 0 && !hasPhoneInLinks) {
  headerItems.push({
    label: phone.trim(),
    url: `tel:${phone.replace(/[^0-9+]/g, '')}`,
  });
}

if (workData?.contactLinks && Array.isArray(workData.contactLinks)) {
  workData.contactLinks.forEach((link) => {
    if (link.show !== false && link.label && link.label.trim().length > 0) {
      headerItems.push({
        label: link.label.trim(),
        url: formatUrl(link.url),
      });
    }
  });
} else {
  // Default fallback if contactLinks is not specified
  if (workData?.portfolioUrl) {
    headerItems.push({
      label: 'Portfolio',
      url: formatUrl(workData.portfolioUrl),
    });
  }
  Object.values(site.socials).forEach((s) => {
    if (s.url.startsWith('http') || s.url.startsWith('mailto')) {
      headerItems.push({
        label: s.label,
        url: formatUrl(s.url),
      });
    }
  });
}
---

<Layout
  title={pageTitle}
  description={
    current
      ? `${name} — ${currentRole ?? current.role} at ${currentCompany ?? current.company}.`
      : `${name}'s work experience.`
  }
  image="/img/og.jpg"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{pageTitle}</p>
      <h1>{name}</h1>
      {currentRole && currentCompany && (
        <p class="muted" style="margin: 0 0 0.25rem;">
          {currentRole} · {currentCompany}
        </p>
      )}
      {headerItems.length > 0 && (
        <p class="muted" style="margin: 0 0 1.5rem;">
          {headerItems.map((item, index) => (
            <>
              {index > 0 && ' · '}
              {item.url ? (
                <a
                  href={item.url.startsWith('/') ? withBase(item.url) : item.url}
                  target={item.url.startsWith('http') ? '_blank' : undefined}
                  rel={item.url.startsWith('http') ? 'noopener' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <span>{item.label}</span>
              )}
            </>
          ))}
        </p>
      )}

      {WorkContent && workEntry?.body && workEntry.body.trim().length > 0 && (
        <div class="prose" style="margin-top: 1.5rem;">
          <WorkContent />
        </div>
      )}
    </div>
  </section>

  {experience && experience.length > 0 && (
    <Experience experience={experience} earlierRoles={earlierRoles} />
  )}

  {education && education.length > 0 && (
    <Education education={education} />
  )}

  {skillGroups && skillGroups.length > 0 && (
    <Skills skillGroups={skillGroups} />
  )}
</Layout>
