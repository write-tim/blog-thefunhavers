---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import { site, withBase } from '../data/site';
import { experience, skillGroups } from '../data/resume';
import { getEntry, render } from 'astro:content';

const homeEntry = await getEntry('pages', 'home');
const renderedHome = homeEntry ? await render(homeEntry) : null;
const HomeContent = renderedHome?.Content;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  url: site.url,
  image: `${site.url}${withBase('/img/og.jpg')}`,
  jobTitle: experience[0]?.role,
  worksFor: { '@type': 'Organization', name: experience[0]?.company },
  email: `mailto:${site.author.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.author.location,
  },
  sameAs: Object.values(site.socials)
    .filter((s) => s.url.startsWith('http'))
    .map((s) => s.url),
  knowsAbout: skillGroups.flatMap((g) => g.skills).slice(0, 8),
};
---

<Layout title={undefined} jsonLd={personJsonLd}>
  <Hero />
  {HomeContent && homeEntry?.body && homeEntry.body.trim().length > 0 && (
    <section class="section" style="padding-top: 0;">
      <div class="container prose">
        <HomeContent />
      </div>
    </section>
  )}
</Layout>
