---
import Layout from '../components/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('pages', ({ data }) => !data.draft);
  const reservedSlugs = new Set([
    '',
    'home',
    'header-footer',
    'work',
    'projects',
    'blog',
    'travel',
    '404',
    'rss.xml',
    'robots.txt',
    'admin',
  ]);

  return entries
    .map((entry) => {
      const fileId = entry.id.replace(/\.(md|mdx)$/, '');
      if (reservedSlugs.has(fileId)) {
        return null;
      }

      const rawSlug = entry.data.slug || fileId;
      const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, '');

      if (reservedSlugs.has(cleanSlug)) {
        return null;
      }

      return {
        params: { slug: cleanSlug },
        props: { entry },
      };
    })
    .filter(Boolean);
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const pageTitle = entry.data.title;
const eyebrow = entry.data.eyebrow;
const description = entry.data.description;
const image = entry.data.image;
---

<Layout title={pageTitle} description={description} image={image}>
  <article class="section">
    <div class="container">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="page-title">{pageTitle}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .page-title {
    margin-bottom: 2rem;
  }
</style>
